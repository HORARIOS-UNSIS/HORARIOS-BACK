# Copia este archivo a .env y sustituye los valores de ejemplo.
# Spring Boot no carga .env automáticamente. En Bash, antes de arrancar:
# set -a
# source .env
# set +a
# bash mvnw spring-boot:run

# PostgreSQL: la base debe existir antes de iniciar el backend.
SPRING_DATASOURCE_URL='jdbc:postgresql://localhost:5432/horarios_unsis'
SPRING_DATASOURCE_USERNAME='postgres'
SPRING_DATASOURCE_PASSWORD='reemplaza_con_tu_clave_local'

# Obligatorio: sustituye por un secreto aleatorio propio de al menos 32 bytes.
# Puedes generar uno localmente con: openssl rand -hex 32
JWT_SECRET='reemplaza_por_un_secreto_aleatorio_de_al_menos_32_bytes'

# Opcionales: valores actuales del proyecto.
SERVER_PORT=8088
APP_JWT_EXPIRATION=86400000
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Habilita solo si tienes acceso a la API universitaria.
INTEGRATION_EXTERNAL_ENABLED=false
API_EXTERNAL_BASEURL='http://serv-horarios.unsis.lan'
